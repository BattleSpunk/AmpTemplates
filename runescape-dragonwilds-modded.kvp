Meta.DisplayName=RuneScape: Dragonwilds - Modded (Proton TEST)
Meta.Description=RuneScape: Dragonwilds Dedicated Server, forced onto the Windows binary and run under Proton GE so UE4SS mods can load. The official native template (runescape-dragonwilds.kvp) launches the native Linux shipping binary directly, which cannot load UE4SS at all.
Meta.OS=Windows, Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=Greelan (original), BattleSpunk/Claude (Proton/UE4SS conversion)
Meta.URL=https://dragonwilds.runescape.com/
Meta.DisplayImageSource=url:https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1374490/d0c222ee8a08f20eacf8a28fe8feb6c378433281/header.jpg?t=1774967430
Meta.EndpointURIFormat=
Meta.ConfigManifest=runescape-dragonwilds-moddedconfig.json
Meta.MetaConfigManifest=runescape-dragonwilds-moddedmetaconfig.json
Meta.ConfigRoot=runescape-dragonwilds-modded.kvp
Meta.MinAMPVersion=2.6.0.8
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=SupportedOnWindows, RecommendedOnLinux
Meta.ContainerPolicyReason=The server is forced onto the Windows binary and run under Proton GE (downloaded by an update stage) so UE4SS - a Windows DLL - can load. The native Linux shipping binary used by the official template cannot load UE4SS at all. The server is launched with Proton GE's own wine binary (not the proton script, whose start.exe launch loses the game's stdout that AMP's console needs). Proton GE 10 uses fsync/esync, which cuts the cost of the Unreal game thread's synchronisation calls compared to wine-stable.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=3a69dfda-d198-496e-b27a-bee52751c7c1
Meta.ImportableExtensions=[".ini"]
Meta.AppIsMultiIPAware=False
App.DisplayName=RuneScape: Dragonwilds - Modded (Proton TEST)
App.RootDir=./rsdragonwilds/
App.BaseDirectory=./rsdragonwilds/4019830/
App.StoresSupported=CurseForge
App.StoreSpecificSettings={"CurseForgeGameId":"104924"}
App.StoreDownloadLocations={"CurseForge":"{{$FullBaseDir}}RSDragonwilds/Binaries/Win64/ue4ss/Mods"}
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=4019830\RSDragonwilds\Binaries\Win64\RSDragonwildsServer-Win64-Shipping.exe
App.ExecutableLinux=.proton/files/bin/wine
App.WorkingDir=4019830
App.LinuxCommandLineArgs="{{$FullBaseDir}}RSDragonwilds/Binaries/Win64/RSDragonwildsServer-Win64-Shipping.exe"
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} RSDragonwilds -Port={{$GamePort}} {{$FormattedArgs}} -stdout -FullStdOutLogOutput -unattended {{CustomCommandLineArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"SteamAppId":"1374490","HOME":"{{$FullBaseDir}}","WINEPREFIX":"{{$FullRootDir}}.proton/compatdata/pfx","WINESERVER":"{{$FullRootDir}}.proton/files/bin/wineserver","WINEDLLPATH":"{{$FullRootDir}}.proton/files/lib/vkd3d:{{$FullRootDir}}.proton/files/lib/wine","LD_LIBRARY_PATH":"{{$FullRootDir}}.proton/files/lib/x86_64-linux-gnu:{{$FullRootDir}}.proton/files/lib/i386-linux-gnu","WINEESYNC":"1","WINEFSYNC":"1","WINEDEBUG":"-all","WINEDLLOVERRIDES":"version=n,b;mscoree=;mshtml=;winebth.sys=d"}
App.CommandLineParameterFormat=-{0}={1}
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitMethodWindows=None
App.ExitTimeout=30
App.ExitString=exit
App.ExitFile=app_exit.lck
